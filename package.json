{
  "name": "dsh-seismicx",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin exposing the SeismicX earthquake-catalog skill as typed, model-facing tools",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "seismology",
    "earthquake-catalog",
    "phase-picking"
  ],
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json --noCheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-jobs": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
